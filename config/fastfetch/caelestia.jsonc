{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[97m", "\u001b[38;5;87m", "\u001b[38;5;75m", "\u001b[38;5;176m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│  uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{>38} │"
        },
        {
            "type": "shell",
            "key": "│ {$2} shell {$1}",
            "format": "{$2}{pretty-name>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$3} mem   {$1}",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$3}{>38}{$1} │"
        },
        {
            "type": "packages",
            "key": "│  pkgs  {$1}",
            "format": "{all>38} │"
        },
        {
            "type": "command",
            "key": "│ {$2} user  {$1}",
            "text": "echo $USER",
            "format": "{$2}{>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│  hname {$1}",
            "text": "hostnamectl hostname",
            "format": "{>38} │"
        },
        {
            "type": "os",
            "key": "│ {$4} distro{$1}",
            "format": "{$4}{pretty-name>38}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────────────────╯"
        },
        "break"
    ]
}
