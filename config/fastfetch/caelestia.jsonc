{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": "  ",
        "color": "white",
        "constants": ["\u001b[97m", "\u001b[38;5;87m", "\u001b[38;5;75m", "\u001b[38;5;176m"]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}  kernel",
            "format": "{$2}{release>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}  uptime",
            "text": "uptime -p | cut -d ' ' -f 2-",
            "format": "{$2}{>38}{$1} │"
        },
        {
            "type": "shell",
            "key": "│ {$2}  shell ",
            "format": "{$2}{pretty-name>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$3}  mem   ",
            "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{$3}{>38}{$1} │"
        },
        {
            "type": "packages",
            "key": "│ {$3}  pkgs  ",
            "format": "{$3}{all>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$2}  user  ",
            "text": "echo $USER",
            "format": "{$2}{>38}{$1} │"
        },
        {
            "type": "command",
            "key": "│ {$4}  hname ",
            "text": "hostnamectl hostname",
            "format": "{$4}{>38}{$1} │"
        },
        {
            "type": "os",
            "key": "│ {$4}  distro",
            "format": "{$4}{pretty-name>38}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────────────────╯"
        },
        "break"
    ]
}
