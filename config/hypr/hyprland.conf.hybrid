# End-4 × Caelestia Hybrid — Hyprland 0.53.3 (conf, not Lua)
# Generated by install.sh --with-end4 (Step 8.5). Sourcing order:
# 1) End-4 base (env → variables → general → rules → colors → keybinds → execs)
# 2) UserConfigs overrides (ENVariables last env source, UserKeybinds last keybind source)
# 3) monitors.conf / workspaces.conf (nwg-displays)
# 4) End-4 custom/ (user overrides seam)
# Rollback: cp ~/hypr-backup-pre-end4-20260906-115748/hypr/hyprland.conf ~/.config/hypr/hyprland.conf && hyprctl reload

# ── End-4 base ──
source = ~/.config/hypr/end4/env.conf
source = ~/.config/hypr/end4/variables.conf
source = ~/.config/hypr/end4/general.conf
source = ~/.config/hypr/end4/rules.conf
source = ~/.config/hypr/end4/colors.conf
source = ~/.config/hypr/end4/keybinds.conf
source = ~/.config/hypr/end4/execs.conf

# ── User overrides (Caelestia-managed) ──
# UserConfigs ENVariables must remain last env source so Qt 6.11 QML_IMPORT_PATH wins.
source = ~/.config/hypr/UserConfigs/01-UserDefaults.conf
source = ~/.config/hypr/UserConfigs/ENVariables.conf
source = ~/.config/hypr/UserConfigs/Laptops.conf
source = ~/.config/hypr/UserConfigs/LaptopDisplay.conf
source = ~/.config/hypr/UserConfigs/WindowRules.conf
source = ~/.config/hypr/UserConfigs/LayerRules.conf
source = ~/.config/hypr/UserConfigs/UserDecorations.conf
source = ~/.config/hypr/UserConfigs/UserAnimations.conf
source = ~/.config/hypr/UserConfigs/UserKeybinds.conf
source = ~/.config/hypr/UserConfigs/UserSettings.conf
source = ~/.config/hypr/UserConfigs/WorkSpaceRules.conf

# ── Monitors / Workspaces ──
source = ~/.config/hypr/monitors.conf
source = ~/.config/hypr/workspaces.conf

# ── User custom End-4 overrides (empty by default) ──
source = ~/.config/hypr/end4/custom/env.conf
source = ~/.config/hypr/end4/custom/variables.conf
source = ~/.config/hypr/end4/custom/general.conf
source = ~/.config/hypr/end4/custom/rules.conf
source = ~/.config/hypr/end4/custom/colors.conf
source = ~/.config/hypr/end4/custom/keybinds.conf
source = ~/.config/hypr/end4/custom/execs.conf

# ── Caelestia QML import — must be last env line if present (fallback) ──
env = QML_IMPORT_PATH,$HOME/.config/quickshell/caelestia/build/qml:$HOME/qt6.11/6.11.2/gcc_64/qml:/usr/lib/qt6/qml:/usr/lib/x86_64-linux-gnu/qt6/qml
env = CAELESTIA_WALLPAPERS_DIR,$HOME/Pictures/wallpapers
