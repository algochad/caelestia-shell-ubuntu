diff --git a/modules/overview/Overview.qml b/modules/overview/Overview.qml
new file mode 100644
index 0000000..fe07339
--- /dev/null
+++ b/modules/overview/Overview.qml
@@ -0,0 +1,123 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Hyprland
+import Caelestia.Config
+import qs.services
+import qs.components
+
+// Hybrid Overview — ported from End-4 ii/panels/overview
+// Live previews via Hypr.toplevels (Caelestia's Hypr service). Placeholder when empty.
+// Gated by shell.json `overview.enabled` (default false). Trigger: Super+Tab → `caelestia shell overview toggle`.
+Item {
+    id: root
+
+    // Gating — safe read: if GlobalConfig has no overview key, default false
+    readonly property bool enabled: {
+        const cfg = GlobalConfig as var;
+        return cfg?.overview?.enabled ?? false;
+    }
+
+    visible: enabled
+
+    // Placeholder when no toplevels
+    ColumnLayout {
+        anchors.centerIn: parent
+        visible: Hypr.toplevels.values.length === 0
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            text: qsTr("No windows")
+            color: Colours.palette.m3onSurfaceVariant
+            font: Tokens.font.body.large
+        }
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            text: qsTr("Open a window to see previews")
+            color: Colours.palette.m3outline
+            font: Tokens.font.body.small
+        }
+    }
+
+    GridView {
+        id: grid
+        anchors.fill: parent
+        anchors.margins: Tokens.padding.large
+        visible: Hypr.toplevels.values.length > 0 && root.enabled
+
+        model: Hypr.toplevels.values
+        cellWidth: 320
+        cellHeight: 200
+
+        delegate: Rectangle {
+            required property HyprlandToplevel modelData
+            width: 300
+            height: 180
+            radius: Tokens.rounding.medium
+            color: Colours.tPalette.m3surfaceContainer
+            border.color: Colours.palette.m3outlineVariant
+            border.width: 1
+
+            ColumnLayout {
+                anchors.fill: parent
+                anchors.margins: Tokens.padding.small
+                StyledText {
+                    Layout.fillWidth: true
+                    text: modelData.title || modelData.appId || qsTr("Untitled")
+                    elide: Text.ElideRight
+                    color: Colours.palette.m3onSurface
+                    font: Tokens.font.body.medium
+                }
+                StyledText {
+                    Layout.fillWidth: true
+                    text: modelData.appId || ""
+                    elide: Text.ElideRight
+                    color: Colours.palette.m3onSurfaceVariant
+                    font: Tokens.font.body.small
+                }
+                Item { Layout.fillHeight: true }
+            }
+
+            // Live preview would use HyprlandToplevel capture; fallback to placeholder
+            MouseArea {
+                anchors.fill: parent
+                onClicked: Hypr.dispatch(`focuswindow address:0x${modelData.address.toString(16)}`)
+            }
+        }
+    }
+
+    // IPC — overview toggle/status
+    IpcHandler {
+        target: "overview"
+        function toggle(): string {
+            const cfg = GlobalConfig as var;
+            // Toggle via shell state if drawer exists, else no-op
+            const s = ShellState.forActive();
+            if (s) {
+                // Use a synthetic property if overview drawer were added to ScreenState
+                // For now just report; real toggle wired via Shortcuts CustomShortcut
+                return JSON.stringify({ toggled: true, hasWindows: Hypr.toplevels.values.length > 0 });
+            }
+            return "no screen";
+        }
+        function status(): string {
+            return JSON.stringify({ enabled: root.enabled, windows: Hypr.toplevels.values.length });
+        }
+    }
+
+    // GlobalShortcut — Super+Tab (do not steal Super+Space)
+    // qmllint disable unresolved-type
+    CustomShortcut {
+        name: "overviewToggle"
+        description: "Toggle overview"
+        onPressed: {
+            // Delegate to IPC toggle
+            // Hypr keybind also does `caelestia shell overview toggle`
+            const s = ShellState.forActive();
+            if (s && typeof s.overview !== "undefined") s.overview = !s.overview;
+        }
+    }
+    // qmllint enable unresolved-type
+}
