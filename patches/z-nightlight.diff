+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.utils
+
+Singleton {
+    id: root
+
+    property bool enabled: false
+    property int temperature: 4000
+    readonly property int dayTemperature: 6500
+    readonly property int minTemp: 1000
+    readonly property int maxTemp: 6500
+
+    property bool available: false
+    property bool _loaded: false
+    readonly property string statePath: `${Paths.state}/nightlight.json`
+
+    // --- persistence ---
+    FileView {
+        id: storage
+
+        path: root.statePath
+        printErrors: false
+        watchChanges: true
+        onLoaded: {
+            try {
+                const data = JSON.parse(text());
+                if (typeof data.enabled === "boolean") root.enabled = data.enabled;
+                if (typeof data.temperature === "number") {
+                    const t = Math.round(data.temperature);
+                    root.temperature = Math.max(root.minTemp, Math.min(root.maxTemp, t));
+                }
+            } catch (e) {
+                console.warn("[NightLight] failed to parse", root.statePath, e);
+            }
+            root._loaded = true;
+        }
+        onLoadFailed: err => {
+            if (err === FileViewError.FileNotFound) {
+                root._loaded = true;
+                Qt.callLater(() => setText(JSON.stringify({ enabled: root.enabled, temperature: root.temperature })));
+            } else {
+                console.warn("[NightLight] load failed", err);
+                root._loaded = true;
+            }
+        }
+    }
+
+    Timer {
+        id: saveTimer
+        interval: 400
+        repeat: false
+        onTriggered: {
+            if (!root._loaded) return;
+            storage.setText(JSON.stringify({ enabled: root.enabled, temperature: root.temperature }));
+        }
+    }
+
+    function save(): void { if (root._loaded) saveTimer.restart(); }
+
+    // --- availability ---
+    Process {
+        id: availProc
+        running: true
+        command: ["sh", "-c", "command -v wlsunset >/dev/null 2>&1 && echo yes || echo no"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                root.available = text.trim() === "yes";
+                if (!root.available) console.warn("[NightLight] wlsunset not found — install 'wlsunset' package");
+            }
+        }
+    }
+
+    // --- daemon: wlsunset always-on at current temp (T==t) ---
+    Process {
+        id: daemonProc
+        running: root.enabled && root.available && root._loaded
+        command: ["wlsunset", "-T", String(root.temperature + 1), "-t", String(root.temperature), "-S", "06:00", "-s", "06:01", "-g", "1.0"]
+        stdout: StdioCollector { onStreamFinished: if (text.length) console.log("[NightLight]", text.trim()) }
+        stderr: StdioCollector { onStreamFinished: if (text.length) console.warn("[NightLight]", text.trim()) }
+        onRunningChanged: console.log("[NightLight] daemon", running ? "start" : "stop", "temp", root.temperature)
+    }
+
+    function setEnabled(v: bool): void { if (root.enabled === v) return; root.enabled = v; save(); }
+    function setTemperature(v: int): void {
+        const c = Math.max(root.minTemp, Math.min(root.maxTemp, Math.round(v)));
+        if (root.temperature === c) return;
+        root.temperature = c;
+        save();
+        if (daemonProc.running) {
+            daemonProc.running = false;
+            Qt.callLater(() => { if (root.enabled && root.available) daemonProc.running = true; });
+        }
+    }
+
+    IpcHandler {
+        target: "nightlight"
+        function status(): string { return JSON.stringify({ enabled: root.enabled, temperature: root.temperature, available: root.available }); }
+        function enable(): string { root.setEnabled(true); return "enabled"; }
+        function disable(): string { root.setEnabled(false); return "disabled"; }
+        function toggle(): string { root.setEnabled(!root.enabled); return root.enabled ? "enabled" : "disabled"; }
+        function setTemp(v: string): string { const n = parseInt(v, 10); if (isNaN(n)) return "invalid"; root.setTemperature(n); return String(root.temperature); }
+    }
+}
