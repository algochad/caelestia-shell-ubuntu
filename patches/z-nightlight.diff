@@ -0,0 +1,150 @@
+pragma Singleton
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.utils
+
+Singleton {
+    id: root
+
+    property bool enabled: false
+    property int temperature: 4000
+    readonly property int dayTemperature: 6500
+    readonly property int minTemp: 1000
+    readonly property int maxTemp: 6500
+
+    property bool available: false
+    property bool _loaded: false
+    readonly property string statePath: `${Paths.state}/nightlight.json`
+    property string _backend: "hyprsunset"
+
+    FileView {
+        id: storage
+        path: root.statePath
+        printErrors: false
+        watchChanges: true
+        onLoaded: {
+            try {
+                const data = JSON.parse(text());
+                if (typeof data.enabled === "boolean") root.enabled = data.enabled;
+                if (typeof data.temperature === "number") {
+                    const t = Math.round(data.temperature);
+                    root.temperature = Math.max(root.minTemp, Math.min(root.maxTemp, t));
+                }
+            } catch (e) {
+                console.warn("[NightLight] parse fail", e);
+            }
+            root._loaded = true;
+            Qt.callLater(() => root._apply());
+        }
+        onLoadFailed: err => {
+            if (err === FileViewError.FileNotFound) {
+                root._loaded = true;
+                Qt.callLater(() => setText(JSON.stringify({ enabled: root.enabled, temperature: root.temperature })));
+                Qt.callLater(() => root._apply());
+            } else {
+                console.warn("[NightLight] load fail", err);
+                root._loaded = true;
+            }
+        }
+    }
+
+    Timer {
+        id: saveTimer
+        interval: 400
+        repeat: false
+        onTriggered: {
+            if (!root._loaded) return;
+            storage.setText(JSON.stringify({ enabled: root.enabled, temperature: root.temperature }));
+        }
+    }
+    function save(): void { if (root._loaded) saveTimer.restart(); }
+
+    Process {
+        id: availProc
+        running: true
+        command: ["sh", "-c", "PATH=\"$HOME/.local/bin:$PATH\"; command -v hyprsunset >/dev/null 2>&1 && echo hyprsunset || (command -v wlsunset >/dev/null 2>&1 && echo wlsunset || echo none)"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const v = text.trim();
+                if (v === "hyprsunset" || v === "wlsunset") {
+                    root._backend = v;
+                    root.available = true;
+                    if (v === "hyprsunset") Quickshell.execDetached(["sh", "-c", "PATH=\"$HOME/.local/bin:$PATH\" pkill wlsunset 2>/dev/null; true"]);
+                    if (root._loaded) Qt.callLater(() => root._apply());
+                } else {
+                    root.available = false;
+                    console.warn("[NightLight] no backend — install hyprsunset or wlsunset");
+                }
+            }
+        }
+    }
+
+    Process {
+        id: hyprDaemon
+        running: root.available && root._backend === "hyprsunset"
+        command: ["sh", "-c", "PATH=\"$HOME/.local/bin:$PATH\" LD_LIBRARY_PATH=\"$HOME/.local/lib:$LD_LIBRARY_PATH\" exec hyprsunset --identity"]
+        onRunningChanged: if (running && root._loaded) Qt.callLater(() => root._apply())
+    }
+
+    Process {
+        id: wlsDaemon
+        running: root.available && root._backend === "wlsunset" && root.enabled && root._loaded
+        command: ["sh", "-c", "PATH=\"$HOME/.local/bin:$PATH\" exec wlsunset -T " + String(root.temperature + 1) + " -t " + String(root.temperature) + " -S 06:00 -s 06:01 -g 1.0"]
+    }
+
+    Timer { id: retryTimer; interval: 220; onTriggered: root._apply() }
+    Timer { id: tempDebounce; interval: 18; onTriggered: root._applyHypr() }
+
+    function _apply(): void {
+        if (!root._loaded || !root.available) return;
+        if (root._backend === "wlsunset") {
+            if (root.enabled && !wlsDaemon.running) wlsDaemon.running = true;
+            else if (!root.enabled && wlsDaemon.running) wlsDaemon.running = false;
+            else if (root.enabled && wlsDaemon.running) {
+                wlsDaemon.running = false;
+                Qt.callLater(() => { if (root.enabled) wlsDaemon.running = true; });
+            }
+            return;
+        }
+        _applyHypr();
+    }
+
+    function _applyHypr(): void {
+        if (!root._loaded || !root.available || root._backend !== "hyprsunset") return;
+        if (!hyprDaemon.running) { retryTimer.restart(); return; }
+        if (root.enabled) Quickshell.execDetached(["hyprctl", "hyprsunset", "temperature", String(root.temperature)]);
+        else Quickshell.execDetached(["hyprctl", "hyprsunset", "identity"]);
+    }
+
+    onEnabledChanged: {
+        save();
+        tempDebounce.stop();
+        retryTimer.stop();
+        _apply();
+    }
+    onTemperatureChanged: {
+        save();
+        if (!root.enabled) return;
+        if (root._backend === "hyprsunset") tempDebounce.restart();
+        else _apply();
+    }
+
+    function setEnabled(v: bool): void { if (root.enabled === v) return; root.enabled = v; }
+    function setTemperature(v: int): void {
+        const c = Math.max(root.minTemp, Math.min(root.maxTemp, Math.round(v)));
+        if (root.temperature === c) return;
+        root.temperature = c;
+    }
+
+    IpcHandler {
+        target: "nightlight"
+        function status(): string { return JSON.stringify({ enabled: root.enabled, temperature: root.temperature, available: root.available, backend: root._backend }); }
+        function enable(): string { root.setEnabled(true); return "enabled"; }
+        function disable(): string { root.setEnabled(false); return "disabled"; }
+        function toggle(): string { root.setEnabled(!root.enabled); return root.enabled ? "enabled" : "disabled"; }
+        function setTemp(v: string): string { const n = parseInt(v, 10); if (isNaN(n)) return "invalid"; root.setTemperature(n); return String(root.temperature); }
+    }
+}
